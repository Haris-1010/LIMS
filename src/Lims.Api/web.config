<?xml version="1.0" encoding="utf-8"?>
<!--
  IIS settings for LIMS. `dotnet publish` keeps this file and fills in the ASP.NET Core module entry.
  In-process hosting: the app runs inside the IIS worker process (w3wp.exe); no separate Kestrel port.
  Application pool: "No Managed Code", its own identity (see docs/DEPLOYMENT.md).
-->
<configuration>
  <location path="." inheritInChildApplications="false">
    <system.webServer>
      <handlers>
        <add name="aspNetCore" path="*" verb="*" modules="AspNetCoreModuleV2" resourceType="Unspecified" />
      </handlers>
      <aspNetCore processPath="dotnet" arguments=".\Lims.Api.dll" stdoutLogEnabled="false"
                  hostingModel="inprocess" />
      <security>
        <requestFiltering removeServerHeader="true">
          <!-- 2 MB: the largest accepted upload is a logo or signature image (the app enforces its own smaller limits). -->
          <requestLimits maxAllowedContentLength="2097152" />
        </requestFiltering>
      </security>
      <httpProtocol>
        <customHeaders>
          <remove name="X-Powered-By" />
        </customHeaders>
      </httpProtocol>
      <urlCompression doStaticCompression="true" doDynamicCompression="true" />
    </system.webServer>
  </location>
</configuration>
