{
  "_comment": "Copy to <site folder>\\appsettings.Production.json (never into git; Deploy-Lims.ps1 keeps it across updates) and edit. Remove this line. No passwords belong here: the database uses Windows sign-in.",

  "ConnectionStrings": {
    "Lims": "Server=SQLSERVERNAME;Database=LIMS;Trusted_Connection=True;TrustServerCertificate=True;Encrypt=True"
  },

  "AllowedHosts": "lims.lab.local",

  "Security": { "RequireHttps": true },
  "Auth": { "RequireHttpsCookie": true, "SessionHours": 10 },
  "RateLimit": { "RequestsPerMinute": 600 },

  "DataProtection": { "KeysPath": "D:\\LimsData\\keys", "ProtectWithDpapi": true },
  "Logging": { "Path": "D:\\LimsData\\logs" },

  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": { "Microsoft.AspNetCore": "Warning", "Microsoft.EntityFrameworkCore": "Warning" }
    }
  }
}
